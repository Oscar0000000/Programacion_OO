import java.util.Objects;

public class Libro {
    private String titulo;
    private String autor;
    private String isbn;
    private int anioPublicacion;

    // Constructor
    public Libro(String titulo, String autor, String isbn, int anioPublicacion) {
        this.titulo = titulo;
        this.autor = autor;
        this.isbn = isbn;
        this.anioPublicacion = anioPublicacion;
    }

    // Sobrescritura de toString()
    @Override
    public String toString() {
        return "Título: " + titulo + ", Autor: " + autor + ", ISBN: " + isbn + ", Año: " + anioPublicacion;
    }

    // Sobrescritura de equals()
    @Override
    public boolean equals(Object obj) {
        // 1. Verificar si es la misma instancia en memoria
        if (this == obj) return true;
        
        // 2. Verificar si el objeto es nulo o de una clase distinta
        if (obj == null || getClass() != obj.getClass()) return false;
        
        // 3. Castear y comparar el atributo identificador (ISBN)
        Libro otroLibro = (Libro) obj;
        return Objects.equals(this.isbn, otroLibro.isbn);
    }

    // Es buena práctica sobrescribir hashCode siempre que se sobrescribe equals
    @Override
    public int hashCode() {
        return Objects.hash(isbn);
    }
}
